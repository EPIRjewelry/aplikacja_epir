# Token z repo root .dev.vars (custom app epir_ai) — auto-wykrywany, nie trzeba kopiować
# SHOPIFY_ADMIN_TOKEN=   ← już w ../.dev.vars
# SHOP=epir-art-silver-jewellery.myshopify.com

# Google Sheets — opcjonalnie (bez tego → CSV do ../marketing/csv/)
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional: AI title/description enrichment (OpenRouter-compatible API)
OPENROUTER_API_KEY=
# Kolejność fallback (Bielik nie jest na OpenRouter): Kimi K3 → Grok 4.5
OPENROUTER_MODELS=moonshotai/kimi-k3,x-ai/grok-4.5

# Optional overrides (defaults in config/*.json)
# SHEETS_SPREADSHEET_ID=
# SHEETS_TAB_NAME=GMC_Feed
