  // Binding AI — dopiero po osobnej decyzji o modelu (STOP+Pozwalam). Day 1: brak.
  "durable_objects": {
    "bindings": [
      {
        "name": "Gemma",
        "class_name": "Gemma"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Gemma"]
    }
  ]
  // placement / jurisdiction eu: NIESPRAWDZONE, czy konto wymaga. Hint weur = później.
}
