{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gemma",
  "main": "src/index.ts",
  // compatibility_date = dzień scaffoldu (2026-10-30)
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
