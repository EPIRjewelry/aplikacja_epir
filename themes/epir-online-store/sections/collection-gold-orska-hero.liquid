{{ 'collection-gold-orska.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.image
  if hero_image == blank and collection.image != blank
    assign hero_image = collection.image
  endif
  assign cta_url = section.settings.cta_url
  if cta_url == blank
    assign cta_url = '#gold-orska-grid'
  endif
-%}

<div id="gold-orska" class="gold-orska">
  <section class="gold-orska-hero" aria-label="{{ section.settings.heading | default: collection.title | escape }}">
    <div class="gold-orska-hero__media">
      {%- if hero_image != blank -%}
        {%- assign hero_alt = hero_image.alt | default: collection.title -%}
        {{
          hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 1800, 2100, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: hero_alt
        }}
      {%- else -%}
        <div class="gold-orska-hero__placeholder" role="img" aria-label="{{ collection.title | escape }}"></div>
      {%- endif -%}
    </div>
    <div class="gold-orska-hero__scrim" aria-hidden="true"></div>
    <div class="gold-orska-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gold-orska-label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="gold-orska-hero__title">
        {{ section.settings.heading | default: collection.title }}
      </h1>
      {%- if section.settings.text != blank -%}
        <div class="gold-orska-hero__text">{{ section.settings.text }}</div>
      {%- elsif collection.description != blank and section.settings.use_collection_description -%}
        <div class="gold-orska-hero__text">{{ collection.description | strip_html | truncate: 220 }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <div class="gold-orska-hero__actions">
          <a class="gold-orska-btn" href="{{ cta_url }}">{{ section.settings.cta_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Gold Orska hero",
  "tag": "section",
  "class": "section-gold-orska-hero",
  "templates": ["collection"],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Lifestyle preferred (~4:5 or wide). Falls back to collection image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pracownia biżuterii artystycznej"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Biżuteria złota"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Ręcznie formowane złoto z wrocławskiej pracowni — żywa powierzchnia, kamienie naturalne, każdy egzemplarz osobno."
    },
    {
      "type": "checkbox",
      "id": "use_collection_description",
      "label": "Use collection description when intro is empty",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Zobacz modele"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link",
      "info": "Empty = scroll to product grid (#gold-orska-grid)."
    }
  ],
  "presets": [{ "name": "Gold Orska hero" }]
}
{% endschema %}
