{% comment %}
  Kuratorskie realizacje w złocie — odświeżenie bloku „Najciekawsze realizacje”.
  CTA → zaprojektuj (nie stara strona zamówień indywidualnych).
{% endcomment %}

<section id="gold-realizations" class="epir-gold-coll epir-gold-coll--realizations" aria-labelledby="gold-realizations-heading">
  <div class="epir-gc__inner epir-gc__inner--wide">
    <p class="epir-gc__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 id="gold-realizations-heading" class="epir-gc__heading">{{ section.settings.heading }}</h2>
    {% if section.settings.intro != blank %}
      <p class="epir-gc__intro">{{ section.settings.intro }}</p>
    {% endif %}

    <div class="epir-gc__real-grid">
      {% for block in section.blocks %}
        <article class="epir-gc__real" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="epir-gc__real-media">
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1600',
                  sizes: '(min-width: 768px) 50vw, 100vw',
                  alt: block.settings.title
              }}
            </div>
          {% endif %}
          <div class="epir-gc__real-body">
            <h3 class="epir-gc__real-title">{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <div class="epir-gc__real-text">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      {% assign real_cta = section.settings.cta_url | default: pages['zaprojektuj-swoj-model'].url %}
      {% if real_cta == blank %}
        {% assign real_cta = '/pages/zaprojektuj-swoj-model' %}
      {% endif %}
      <div class="epir-gc__real-cta">
        <a href="{{ real_cta }}" class="epir-gc__btn-cta">{{ section.settings.cta_label }}</a>
        {% if section.settings.footnote != blank %}
          <p class="epir-gc__footnote">{{ section.settings.footnote }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .epir-gold-coll--realizations {
    background: var(--epir-bg, #F5F0E8);
    padding: 3.5rem 0 4rem;
    border-top: 1px solid rgba(34,34,34,0.06);
  }
  .epir-gc__real-grid {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .epir-gc__real {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: center;
    }
    .epir-gc__real:nth-child(even) .epir-gc__real-media { order: 2; }
  }
  .epir-gc__real-media {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(201,162,39,0.25);
  }
  .epir-gc__real-media img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .epir-gc__real-title {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
    line-height: 1.25;
  }
  .epir-gc__real-text {
    color: var(--epir-muted, #666);
    line-height: 1.65;
    font-size: 0.98rem;
  }
  .epir-gc__real-text p { margin: 0 0 0.75rem; }
  .epir-gc__real-cta {
    margin-top: 2.5rem;
    text-align: center;
  }
  .epir-gc__footnote {
    margin: 1rem auto 0;
    max-width: 28rem;
    font-size: 0.85rem;
    color: var(--epir-muted, #666);
    line-height: 1.5;
  }
</style>

{% schema %}
{
  "name": "Gold realizations",
  "tag": "section",
  "class": "section-gold-realizations",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pracownia Biżuterii Artystycznej EPIR Art Jewellery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Wybrane realizacje"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Wstęp",
      "default": "Wzory z kolekcji i projekty według Twojego szkicu. Wszystko powstaje we Wrocławiu."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA",
      "default": "Zaprojektuj swój model"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "URL CTA (domyślnie: zaprojektuj-swoj-model)"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Stopka",
      "default": "W razie wątpliwości: +48 698 718 564"
    }
  ],
  "blocks": [
    {
      "type": "realization",
      "name": "Realizacja",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Zdjęcie" },
        {
          "type": "text",
          "id": "title",
          "label": "Tytuł",
          "default": "Komplet biżuterii złotej z tanzanitami"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Opis",
          "default": "<p>Komplet ze złota i tanzanitów. Ciepłe złoto i głęboki błękit kamienia — wykonany na zamówienie w pracowni.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gold realizations",
      "blocks": [
        {
          "type": "realization",
          "settings": {
            "title": "Komplet biżuterii złotej z tanzanitami",
            "text": "<p>Komplet ze złota i tanzanitów. Ciepłe złoto i głęboki błękit kamienia — wykonany na zamówienie w pracowni.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
