{% comment %}
  Most do marki partnerskiej (Kazka Jewelry) — stopka kolekcji, nie oferta równorzędna.
  Kazka ma własny storefront (kazka.epirbizuteria.pl) i własny tor kampanii.
{% endcomment %}

<section
  id="partner-bridge"
  class="epir-gold-coll epir-gold-coll--partner"
  aria-labelledby="partner-bridge-heading"
>
  <div class="epir-gc__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="epir-gc__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 id="partner-bridge-heading" class="epir-gc__heading">{{ section.settings.heading }}</h2>
    {% if section.settings.body != blank %}
      <p class="epir-gc__intro">{{ section.settings.body }}</p>
    {% endif %}
    {% assign bridge_href = section.settings.cta_url | default: 'https://kazka.epirbizuteria.pl' %}
    <a href="{{ bridge_href }}" class="epir-gc__btn-link" rel="noopener">
      {{ section.settings.cta_label }}
    </a>
  </div>
</section>

<style>
  .epir-gold-coll--partner {
    background: #FBF8F3;
    padding: 2.5rem 0;
    border-top: 1px solid rgba(34, 34, 34, 0.06);
    text-align: center;
  }
  .epir-gold-coll--partner .epir-gc__inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .epir-gold-coll--partner .epir-gc__eyebrow {
    margin: 0 0 0.75rem;
    opacity: 0.7;
  }
  .epir-gold-coll--partner .epir-gc__heading {
    max-width: 26ch;
    margin: 0 auto 0.75rem;
    font-size: 1.25rem;
    line-height: 1.5;
    text-align: center;
  }
  .epir-gold-coll--partner .epir-gc__intro {
    max-width: 52ch;
    margin: 0 auto 1.25rem;
  }
  .epir-gold-coll--partner .epir-gc__btn-link {
    display: inline-block;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid currentColor;
    color: #222;
  }
  .epir-gold-coll--partner .epir-gc__btn-link:hover {
    color: #2c684e;
  }
</style>

{% schema %}
{
  "name": "Partner bridge",
  "tag": "section",
  "class": "section-partner-bridge",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Marka partnerska"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Szukasz polerowanej geometrii? Kazka Jewelry"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Opis",
      "default": "Złoto i brylant w chłodnej, geometrycznej formie — osobny sklep, który prowadzimy jako partner. Nasze kute złoto zostaje tutaj."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA",
      "default": "Zobacz Kazka Jewelry"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "URL CTA (domyślnie: kazka.epirbizuteria.pl)"
    }
  ],
  "presets": [
    {
      "name": "Partner bridge"
    }
  ]
}
{% endschema %}
