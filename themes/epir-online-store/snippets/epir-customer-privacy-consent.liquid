{% comment %}
  EPIR storefront consent banner. This is the banner the theme renders.
  Minimog cookie-banner is not rendered from layout/theme.liquid.

  Visible copy names three purposes: analityka (wizyty), marketing (reklamy i remarketing), preferencje.
  Zaakceptuj / Odrzuć call customerPrivacy.setTrackingConsent from the asset.
  No call on load. Does not send pixel events.

  Theme push after operator approval, these files only:
    layout/theme.liquid
    snippets/epir-customer-privacy-consent.liquid
    assets/epir-customer-privacy-consent.js
{% endcomment %}

<div
  id="epir-customer-privacy-banner"
  class="epir-customer-privacy-banner"
  role="region"
  aria-label="Zgoda przed śledzeniem"
  data-epir-privacy-banner
>
  <p>
    Zanim sklep zacznie mierzyć ruch, wybierz zgodę. Zaakceptuj obejmuje trzy cele: analityka (wizyty), marketing (reklamy i remarketing) i preferencje.
  </p>
  <div class="epir-customer-privacy-banner__actions">
    <button type="button" data-epir-consent="accept">Zaakceptuj</button>
    <button type="button" data-epir-consent="reject">Odrzuć</button>
  </div>
</div>

<style>
  .epir-customer-privacy-banner {
    position: fixed;
    z-index: 9999;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    padding: 1rem 1.25rem calc(1rem + env(safe-area-inset-bottom, 0px));
    background: #f3eee6;
    color: #2c2825;
    border-top: 1px solid #d8cfc3;
    font: inherit;
    line-height: 1.45;
  }
  .epir-customer-privacy-banner[hidden] {
    display: none !important;
  }
  .epir-customer-privacy-banner p {
    margin: 0;
    max-width: 46rem;
    flex: 1 1 16rem;
  }
  .epir-customer-privacy-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .epir-customer-privacy-banner button {
    appearance: none;
    border: 1px solid #2c2825;
    background: transparent;
    color: inherit;
    padding: 0.65rem 1rem;
    cursor: pointer;
    font: inherit;
  }
  .epir-customer-privacy-banner button[data-epir-consent="accept"] {
    background: #2c2825;
    color: #f3eee6;
  }
</style>

<script src="{{ 'epir-customer-privacy-consent.js' | asset_url }}"></script>
